# Copy this file to .env only on your own server. Do not commit the resulting .env file.
CINEFLOW_PORT=3000
CINEFLOW_PUBLIC_URL=https://cineflow.example.com
# Set true after HTTPS is terminated by your proxy.
CINEFLOW_COOKIE_SECURE=false

# MySQL 8
MYSQL_DATABASE=cineflow
MYSQL_USER=cineflow
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
DATABASE_URL=mysql://cineflow:replace-with-a-strong-password@db:3306/cineflow

# S3-compatible storage. Docker Compose uses its included MinIO service by default.
CINEFLOW_STORAGE_DRIVER=s3
S3_BUCKET=cineflow
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=replace-with-a-minimum-16-character-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-minimum-32-character-secret-key
MINIO_CONSOLE_PORT=9001

# OpenAI-compatible LLM for command interpretation and AI Producer.
CINEFLOW_LLM_BASE_URL=https://your-llm-provider.example/v1
CINEFLOW_LLM_API_KEY=replace-with-your-provider-key
CINEFLOW_LLM_DEFAULT_MODEL=your-chat-model

# OpenAI-compatible Whisper transcription endpoint for subtitle generation.
CINEFLOW_TRANSCRIPTION_BASE_URL=https://your-transcription-provider.example/v1
CINEFLOW_TRANSCRIPTION_API_KEY=replace-with-your-provider-key
CINEFLOW_TRANSCRIPTION_MODEL=whisper-1
